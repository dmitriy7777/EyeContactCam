<Window x:Class="EyeContactCam.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EyeContact Cam" Width="1180" Height="760" MinWidth="940" MinHeight="620" Background="#0B1020" Foreground="White" Closing="Window_Closing">
 <Grid Margin="22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,18"><TextBlock Text="EyeContact Cam" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Локальная коррекция взгляда • кадры не отправляются в интернет" Foreground="#9AA7C7" Margin="0,4,0,0"/></StackPanel>
  <Border Grid.Row="1" Background="#050812" CornerRadius="14" Margin="0,0,18,0" ClipToBounds="True"><Grid><Image x:Name="PreviewImage" Stretch="Uniform"/><TextBlock x:Name="EmptyText" Text="Нажмите «Запустить камеру»" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7884A3" FontSize="18"/></Grid></Border>
  <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="20"><StackPanel>
   <TextBlock Text="1. Камера" FontSize="17" FontWeight="SemiBold"/><ComboBox x:Name="CameraBox" Margin="0,10,0,10" Height="36" SelectedIndex="0"><ComboBoxItem Content="Встроенная камера (0)" Tag="0"/></ComboBox><Button x:Name="StartButton" Content="Запустить камеру" Click="StartCamera_Click" Background="#3A4562"/>
   <Separator Margin="0,10" Background="#303950"/><TextBlock Text="2. Скан лица и глаз" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Смотрите прямо в объектив 3 секунды. Профиль сохраняется только на этом ПК." TextWrapping="Wrap" Foreground="#9AA7C7" Margin="0,8,0,12"/><ProgressBar x:Name="ScanProgress" Height="7" Minimum="0" Maximum="100"/><Button x:Name="ScanButton" Content="Сканировать" Click="Scan_Click" IsEnabled="False" Margin="0,12,10,10"/><CheckBox x:Name="CorrectionCheck" Content="Сильная коррекция взгляда" IsChecked="True" IsEnabled="False" Margin="0,4,0,10"/><TextBlock x:Name="TrackingText" Text="Глаза: ожидание камеры" Foreground="#A9B7DB" Margin="0,0,0,10"/><TextBlock Text="Сила коррекции" Foreground="#9AA7C7"/><Slider x:Name="StrengthSlider" Minimum="0" Maximum="1" Value="1" Margin="0,5,0,12"/>
   <Separator Margin="0,6,0,12" Background="#303950"/><TextBlock Text="3. Виртуальная камера" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ObsStatus" Text="Проверка OBS…" TextWrapping="Wrap" Foreground="#9AA7C7" Margin="0,8,0,12"/><Button x:Name="VirtualButton" Content="Активировать виртуальную камеру" Click="VirtualCamera_Click" Background="{StaticResource AccentBrush}"/>
  </StackPanel></Border><Border Grid.Row="2" Grid.ColumnSpan="2" Background="#11182A" CornerRadius="9" Margin="0,16,0,0" Padding="12,9"><TextBlock x:Name="StatusText" Text="Готово к запуску" Foreground="#B8C4E2"/></Border>
 </Grid>
</Window>
